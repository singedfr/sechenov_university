/* =====================================================================
   RESET & BASE
   ===================================================================== */
* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

html {
    font-size: clamp(14px, 1.5vw, 16px);
    scroll-behavior: smooth;
}

body {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto,
                 "Helvetica Neue", Arial, sans-serif;
    background: #f5f7fa;
    color: #2c3e50;
    line-height: 1.6;
    min-height: 100vh;
    padding: 0;
    /* НЕТ никаких background-image — убираем декоративные картинки по бокам */
}

img {
    max-width: 100%;
    height: auto;
    display: block;
}

/* =====================================================================
   CONTAINER — ограничивает ширину контента
   ===================================================================== */
.container {
    max-width: 1100px;
    margin: 0 auto;
    padding: clamp(16px, 3vw, 40px);
}

.container-wide {
    max-width: 1300px;
}

/* =====================================================================
   HEADER
   ===================================================================== */
.header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding-bottom: 20px;
    margin-bottom: clamp(24px, 4vw, 48px);
    border-bottom: 1px solid #e1e6ec;
    flex-wrap: wrap;
}

.logo-img {
    max-width: 280px;
    height: auto;
    width: 100%;
}

/* На мобильных — логотип меньше */
@media (max-width: 600px) {
    .logo-img {
        max-width: 180px;
    }
}

.back-link {
    color: #1f4e79;
    text-decoration: none;
    font-weight: 500;
    padding: 8px 12px;
    border-radius: 6px;
    transition: background 0.2s;
}

.back-link:hover {
    background: #eaf4ff;
}

/* =====================================================================
   ТИПОГРАФИКА
   ===================================================================== */
h1 {
    font-size: clamp(1.8rem, 4vw, 3rem);
    line-height: 1.2;
    color: #1f4e79;
    margin-bottom: 16px;
    text-align: center;
}

h2 {
    font-size: clamp(1.3rem, 2.5vw, 1.8rem);
    color: #1f4e79;
    margin: 24px 0 12px;
}

h3 {
    font-size: clamp(1.1rem, 2vw, 1.3rem);
    color: #2c3e50;
    margin: 20px 0 10px;
}

.subtitle {
    text-align: center;
    font-size: clamp(1rem, 1.6vw, 1.15rem);
    color: #5a6b7c;
    margin-bottom: clamp(24px, 4vw, 40px);
    max-width: 700px;
    margin-left: auto;
    margin-right: auto;
}

/* =====================================================================
   ГЛАВНАЯ СТРАНИЦА (index.html)
   ===================================================================== */
.buttons {
    display: flex;
    gap: 20px;
    justify-content: center;
    flex-wrap: wrap;
    margin: clamp(24px, 4vw, 40px) 0;
}

.btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 14px 28px;
    font-size: 1rem;
    font-weight: 600;
    border: none;
    border-radius: 10px;
    cursor: pointer;
    text-decoration: none;
    transition: all 0.2s ease;
    font-family: inherit;
}

.btn-doctor {
    background: #1f4e79;
    color: #ffffff;
}

.btn-doctor:hover {
    background: #163a5c;
    transform: translateY(-2px);
    box-shadow: 0 6px 16px rgba(31, 78, 121, 0.3);
}

.btn-patient {
    background: #ffffff;
    color: #1f4e79;
    border: 2px solid #1f4e79;
}

.btn-patient:hover {
    background: #eaf4ff;
    transform: translateY(-2px);
}

.btn-secondary {
    background: #f0f2f5;
    color: #2c3e50;
}

.btn-secondary:hover {
    background: #e1e6ec;
}

.btn-primary {
    background: #1f4e79;
    color: #ffffff;
}

.btn-primary:hover {
    background: #163a5c;
}

.btn:disabled {
    opacity: 0.6;
    cursor: not-allowed;
    transform: none;
}

/* Большие кнопки для главной */
.buttons .btn {
    min-width: 220px;
    padding: 18px 36px;
    font-size: 1.1rem;
}

@media (max-width: 600px) {
    .buttons {
        flex-direction: column;
        align-items: stretch;
    }
    .buttons .btn {
        width: 100%;
    }
}

/* =====================================================================
   DISCLAIMER
   ===================================================================== */
.disclaimer {
    font-size: 0.9rem;
    color: #7a8a99;
    text-align: center;
    margin-top: 32px;
    padding: 16px;
    background: #f9fafb;
    border-radius: 8px;
    border-left: 3px solid #b6c9e0;
}

/* =====================================================================
   ФОРМА (doctor.html)
   ===================================================================== */
.form-section {
    border: 1px solid #e1e6ec;
    border-radius: 10px;
    margin-bottom: 16px;
    padding: 0 20px;
    background: #ffffff;
    overflow: hidden;
}

.form-section[open] {
    padding-bottom: 20px;
}

.form-section > summary {
    cursor: pointer;
    font-weight: 600;
    font-size: clamp(1rem, 1.6vw, 1.15rem);
    padding: 16px 0;
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    color: #1f4e79;
    user-select: none;
}

.form-section > summary::after {
    content: "▸";
    font-size: 1.3em;
    transition: transform 0.2s;
    color: #1f4e79;
    margin-left: 12px;
}

.form-section[open] > summary::after {
    transform: rotate(90deg);
}

.form-section > summary::-webkit-details-marker {
    display: none;
}

.required-note {
    font-size: 0.8em;
    font-weight: normal;
    color: #d9534f;
    margin-left: auto;
}

/* СЕТКА ПОЛЕЙ — адаптивная */
.form-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 16px;
}

@media (max-width: 480px) {
    .form-grid {
        grid-template-columns: 1fr;
    }
}

.form-group {
    display: flex;
    flex-direction: column;
}

.form-group label {
    font-size: 0.9rem;
    font-weight: 500;
    margin-bottom: 6px;
    color: #3a4a5c;
}

.form-group input,
.form-group select {
    padding: 10px 12px;
    font-size: 0.95rem;
    border: 1px solid #cfd8e3;
    border-radius: 6px;
    font-family: inherit;
    transition: border 0.2s, box-shadow 0.2s;
    background: #ffffff;
}

.form-group input:focus,
.form-group select:focus {
    outline: none;
    border-color: #1f4e79;
    box-shadow: 0 0 0 3px rgba(31, 78, 121, 0.1);
}

.form-group input::placeholder {
    color: #a8b4c0;
}

/* =====================================================================
   КНОПКИ ДЕЙСТВИЙ ФОРМЫ
   ===================================================================== */
.form-actions {
    display: flex;
    gap: 12px;
    margin-top: 24px;
    flex-wrap: wrap;
}

@media (max-width: 600px) {
    .form-actions {
        flex-direction: column;
    }
    .form-actions .btn {
        width: 100%;
    }
}

/* =====================================================================
   PDF-ЗАГРУЗКА
   ===================================================================== */
.pdf-upload-block {
    background: #f7f9fc;
    border: 2px dashed #b6c9e0;
    border-radius: 12px;
    padding: 20px;
    margin: 20px 0;
}

.pdf-upload-block h3 {
    margin-top: 0;
    color: #1f4e79;
}

.pdf-hint {
    font-size: 0.9em;
    color: #666;
    margin-bottom: 16px;
}

.pdf-controls {
    display: flex;
    gap: 12px;
    align-items: center;
    flex-wrap: wrap;
}

.pdf-file-name {
    color: #666;
    font-style: italic;
    word-break: break-all;
}

.pdf-status {
    margin-top: 16px;
    padding: 12px;
    border-radius: 8px;
    background: #eaf4ff;
    color: #1f4e79;
}

.pdf-status.success {
    background: #e8f5e9;
    color: #2e7d32;
}

.pdf-status.error {
    background: #fdecea;
    color: #a94442;
}

.field-autofilled {
    background: #e8f5e9 !important;
    border-color: #4caf50 !important;
}

/* =====================================================================
   СТАТУСЫ (loading, error, result)
   ===================================================================== */
.hidden {
    display: none !important;
}

.loading {
    padding: 16px;
    background: #eaf4ff;
    border-radius: 8px;
    color: #1f4e79;
    font-weight: 500;
    text-align: center;
    margin-top: 16px;
}

.error {
    padding: 16px;
    background: #fdecea;
    border-left: 4px solid #d9534f;
    border-radius: 8px;
    color: #a94442;
    margin-top: 16px;
    word-break: break-word;
}

.result {
    margin-top: 24px;
    padding: clamp(16px, 3vw, 24px);
    background: #ffffff;
    border-radius: 12px;
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.06);
}

/* =====================================================================
   ДИАГНОЗ (результат врача)
   ===================================================================== */
.diagnosis-block {
    padding: 20px;
    border-radius: 10px;
    margin-bottom: 20px;
}

.diagnosis-anemia {
    background: #fdecea;
    border-left: 5px solid #d9534f;
}

.diagnosis-normal {
    background: #e8f5e9;
    border-left: 5px solid #4caf50;
}

.diagnosis-title {
    font-size: 1.3rem;
    font-weight: 700;
    margin-bottom: 8px;
}

.diagnosis-class {
    font-size: 1.05rem;
    margin-bottom: 4px;
}

.diagnosis-prob {
    font-size: 0.95rem;
    color: #5a6b7c;
}

/* Полнота данных */
.completeness-block {
    padding: 12px 16px;
    border-radius: 8px;
    font-size: 0.95rem;
    margin-bottom: 20px;
}

.completeness-good {
    background: #e8f5e9;
    color: #2e7d32;
}

.completeness-warn {
    background: #fff8e1;
    color: #b87200;
}

.completeness-bad {
    background: #fdecea;
    color: #a94442;
}

/* Прогресс-бары классов */
.prob-list {
    margin: 16px 0;
}

.prob-row {
    display: grid;
    grid-template-columns: minmax(140px, 1fr) 2fr auto;
    gap: 12px;
    align-items: center;
    margin-bottom: 10px;
}

@media (max-width: 600px) {
    .prob-row {
        grid-template-columns: 1fr;
        gap: 4px;
    }
}

.prob-label {
    font-size: 0.9rem;
    color: #3a4a5c;
    word-break: break-word;
}

.prob-bar {
    background: #eaf1f8;
    height: 10px;
    border-radius: 5px;
    overflow: hidden;
}

.prob-fill {
    background: linear-gradient(90deg, #1f4e79, #4a7bb0);
    height: 100%;
    transition: width 0.5s ease;
}

.prob-value {
    font-weight: 600;
    font-size: 0.9rem;
    text-align: right;
    color: #1f4e79;
    min-width: 60px;
}

/* Таблица признаков */
.features-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9rem;
    margin: 12px 0;
}

.features-table th,
.features-table td {
    padding: 10px 12px;
    text-align: left;
    border-bottom: 1px solid #e1e6ec;
}

.features-table th {
    background: #f5f7fa;
    color: #3a4a5c;
    font-weight: 600;
}

/* Пропущенные признаки */
.missing-block {
    margin: 16px 0;
    padding: 14px 16px;
    background: #fff8e1;
    border-left: 4px solid #ffb74d;
    border-radius: 8px;
}

.missing-block h4 {
    margin: 0 0 8px;
    color: #b87200;
    font-size: 0.95rem;
}

.missing-list {
    font-size: 0.85rem;
    color: #5a6b7c;
    word-break: break-word;
}

.all-complete {
    color: #2e7d32;
    font-weight: 500;
    padding: 12px;
    background: #e8f5e9;
    border-radius: 8px;
    margin: 16px 0;
}

/* Рекомендации */
.recommendation {
    padding: 16px;
    background: #f7f9fc;
    border-left: 4px solid #1f4e79;
    border-radius: 8px;
    white-space: pre-line;
    font-size: 0.95rem;
    line-height: 1.7;
}

/* =====================================================================
   РЕЗУЛЬТАТ ПАЦИЕНТА
   ===================================================================== */
.patient-summary {
    padding: 20px;
    background: #f7f9fc;
    border-radius: 10px;
    margin: 16px 0;
}

.patient-status {
    font-size: clamp(1.1rem, 2vw, 1.4rem);
    font-weight: 600;
    padding: 16px;
    border-radius: 8px;
    margin: 16px 0;
    text-align: center;
}

.patient-status.anemia {
    background: #fdecea;
    color: #b00020;
}

.patient-status.normal {
    background: #e8f5e9;
    color: #2e7d32;
}

.patient-actions {
    padding-left: 24px;
    font-size: 1rem;
    line-height: 1.9;
}

.patient-actions li {
    margin-bottom: 8px;
}

.record-meta {
    font-size: 0.9rem;
    color: #7a8a99;
    text-align: center;
    margin-bottom: 16px;
}

/* =====================================================================
   CODE ENTRY (patient.html)
   ===================================================================== */
.code-entry {
    max-width: 480px;
    margin: 40px auto;
    padding: clamp(20px, 4vw, 32px);
    background: #f7f9fc;
    border-radius: 12px;
    text-align: center;
}

.code-entry label {
    display: block;
    margin-bottom: 8px;
    font-weight: 600;
    color: #1f4e79;
}

.code-input {
    width: 100%;
    padding: 16px;
    font-size: clamp(1.4rem, 4vw, 1.8rem);
    text-align: center;
    letter-spacing: 0.3em;
    font-family: "Courier New", monospace;
    text-transform: uppercase;
    border: 2px solid #b6c9e0;
    border-radius: 8px;
    margin-bottom: 16px;
    background: #ffffff;
}

.code-input:focus {
    outline: none;
    border-color: #1f4e79;
    box-shadow: 0 0 0 4px rgba(31, 78, 121, 0.1);
}

.patient-result {
    max-width: 700px;
    margin: 32px auto;
    padding: clamp(20px, 4vw, 32px);
    background: #ffffff;
    border-radius: 12px;
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.08);
}

/* =====================================================================
   SHARE BLOCK (врач делится кодом)
   ===================================================================== */
.share-block {
    background: #fff8e1;
    border: 2px solid #ffcc80;
    border-radius: 12px;
    padding: clamp(16px, 3vw, 24px);
    margin-top: 24px;
}

.share-block h3 {
    margin-top: 0;
    color: #b87200;
}

.share-result {
    margin-top: 16px;
    padding: 16px;
    background: #ffffff;
    border-radius: 8px;
    border: 1px dashed #b87200;
    text-align: center;
}

.patient-code {
    font-size: clamp(1.8rem, 5vw, 2.5rem);
    font-weight: bold;
    letter-spacing: 0.25em;
    color: #1f4e79;
    font-family: "Courier New", monospace;
    margin: 12px 0;
    padding: 16px;
    background: #eaf4ff;
    border-radius: 8px;
    user-select: all;
    word-break: break-all;
}

.patient-code-hint {
    color: #666;
    font-size: 0.9em;
}

/* =====================================================================
   ПЕЧАТЬ
   ===================================================================== */
@media print {
    body {
        background: #ffffff;
    }
    .btn,
    .form-actions,
    .share-block,
    .back-link {
        display: none !important;
    }
    .result,
    .patient-result {
        box-shadow: none;
        padding: 0;
    }
}